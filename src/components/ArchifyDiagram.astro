---
interface Props {
  src: string;
  title: string;
  height?: string;
  caption?: string;
}

const {
  src,
  title,
  height = '560px',
  caption
} = Astro.props;
---

<div class="archify-embed-card">
  <div class="archify-embed-header">
    <div class="archify-title-wrap">
      <span class="archify-badge">Archify Interactive</span>
      <span class="archify-title">{title}</span>
    </div>
    <div class="archify-actions">
      <a href={src} target="_blank" rel="noopener noreferrer" class="archify-link-btn" title="Open diagram in full screen">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
          <polyline points="15 3 21 3 21 9"></polyline>
          <line x1="10" y1="14" x2="21" y2="3"></line>
        </svg>
        <span>Full screen</span>
      </a>
    </div>
  </div>

  <div class="archify-frame-wrapper" style={`height: ${height};`}>
    <iframe
      src={src}
      title={title}
      loading="lazy"
      class="archify-iframe"
      allow="fullscreen"
    ></iframe>
  </div>

  {caption && (
    <div class="archify-embed-footer">
      <p class="archify-caption">{caption}</p>
    </div>
  )}
</div>

<style>
  .archify-embed-card {
    margin: 1.75rem 0;
    border: 1px solid color-mix(in srgb, var(--sl-color-accent) 30%, var(--sl-color-gray-5, #24333e));
    border-radius: 0.75rem;
    overflow: hidden;
    background: color-mix(in srgb, var(--sl-color-black, #0a1114) 85%, var(--sl-color-accent-low, #102b3a));
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
  }

  .archify-embed-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1rem;
    background: color-mix(in srgb, var(--sl-color-gray-6, #132025) 90%, black);
    border-bottom: 1px solid color-mix(in srgb, var(--sl-color-accent) 20%, transparent);
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .archify-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .archify-badge {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--sl-color-accent-high, #a4edf0);
    background: color-mix(in srgb, var(--sl-color-accent) 25%, transparent);
    border: 1px solid color-mix(in srgb, var(--sl-color-accent) 50%, transparent);
    border-radius: 999px;
  }

  .archify-title {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--sl-color-white, #f3f7f8);
  }

  .archify-actions {
    display: flex;
    gap: 0.5rem;
  }

  .archify-link-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78rem;
    font-weight: 500;
    padding: 0.3rem 0.65rem;
    border-radius: 0.375rem;
    color: var(--sl-color-accent-high, #a4edf0);
    background: color-mix(in srgb, var(--sl-color-accent-low) 50%, transparent);
    border: 1px solid color-mix(in srgb, var(--sl-color-accent) 35%, transparent);
    text-decoration: none;
    transition: all 0.15s ease-in-out;
  }

  .archify-link-btn:hover {
    background: var(--sl-color-accent);
    color: #041014;
    border-color: var(--sl-color-accent);
    text-decoration: none;
  }

  .archify-frame-wrapper {
    position: relative;
    width: 100%;
    min-height: 400px;
    background: #0d1117;
  }

  .archify-iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .archify-embed-footer {
    padding: 0.6rem 1rem;
    background: color-mix(in srgb, var(--sl-color-gray-6, #132025) 75%, transparent);
    border-top: 1px solid color-mix(in srgb, var(--sl-color-accent) 15%, transparent);
  }

  .archify-caption {
    font-size: 0.82rem;
    color: var(--sl-color-gray-2, #a7b6b9);
    margin: 0;
    line-height: 1.4;
  }
</style>
