---
interface Props {
  src: string;
  title: string;
  height?: string;
  caption?: string;
}

const {
  src,
  title,
  height = '580px',
  caption
} = Astro.props;

const containerId = `archify-${Math.random().toString(36).substring(2, 9)}`;
---

<div class="archify-embed-card" id={containerId}>
  <div class="archify-embed-header">
    <div class="archify-title-wrap">
      <span class="archify-badge">
        <span class="pulse-dot"></span>
        Archify Interactive
      </span>
      <span class="archify-title">{title}</span>
    </div>
    <div class="archify-actions">
      <button
        type="button"
        class="archify-action-btn js-fullscreen-btn"
        data-target={containerId}
        title="Toggle Fullscreen"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path>
        </svg>
        <span>Fullscreen</span>
      </button>

      <a href={src} target="_blank" rel="noopener noreferrer" class="archify-action-btn" title="Open standalone diagram in new tab">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
          <polyline points="15 3 21 3 21 9"></polyline>
          <line x1="10" y1="14" x2="21" y2="3"></line>
        </svg>
        <span>New tab</span>
      </a>
    </div>
  </div>

  <div class="archify-frame-wrapper" style={`height: ${height};`}>
    <iframe
      src={src}
      title={title}
      loading="lazy"
      class="archify-iframe"
      allow="fullscreen"
    ></iframe>
  </div>

  {caption && (
    <div class="archify-embed-footer">
      <p class="archify-caption">{caption}</p>
    </div>
  )}
</div>

<script>
  function setupFullscreen() {
    const buttons = document.querySelectorAll('.js-fullscreen-btn');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        if (!targetId) return;
        const container = document.getElementById(targetId);
        if (!container) return;

        if (!document.fullscreenElement) {
          container.requestFullscreen().catch((err) => {
            console.warn(`Error attempting to enable fullscreen: ${err.message}`);
          });
        } else {
          document.exitFullscreen();
        }
      });
    });
  }

  // Setup on initial load and View Transitions
  setupFullscreen();
  document.addEventListener('astro:page-load', setupFullscreen);
</script>

<style>
  .archify-embed-card {
    margin: 1.75rem 0;
    border: 1px solid color-mix(in srgb, var(--sl-color-accent) 35%, var(--sl-color-gray-5, #24333e));
    border-radius: 0.75rem;
    overflow: hidden;
    background: color-mix(in srgb, var(--sl-color-black, #0a1114) 90%, var(--sl-color-accent-low, #102b3a));
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.4);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .archify-embed-card:hover {
    border-color: color-mix(in srgb, var(--sl-color-accent-high) 50%, var(--sl-color-accent));
    box-shadow: 0 10px 36px rgba(29, 138, 153, 0.18);
  }

  .archify-embed-card:fullscreen {
    border-radius: 0;
    margin: 0;
    width: 100vw;
    height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .archify-embed-card:fullscreen .archify-frame-wrapper {
    flex: 1;
    height: auto !important;
  }

  .archify-embed-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1rem;
    background: color-mix(in srgb, var(--sl-color-gray-6, #132025) 92%, black);
    border-bottom: 1px solid color-mix(in srgb, var(--sl-color-accent) 20%, transparent);
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .archify-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .archify-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.55rem;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--sl-color-accent-high, #a4edf0);
    background: color-mix(in srgb, var(--sl-color-accent) 22%, transparent);
    border: 1px solid color-mix(in srgb, var(--sl-color-accent) 45%, transparent);
    border-radius: 999px;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--sl-color-accent-high, #a4edf0);
    box-shadow: 0 0 8px var(--sl-color-accent-high);
    display: inline-block;
    animation: pulse 2s infinite ease-in-out;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .archify-title {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--sl-color-white, #f3f7f8);
  }

  .archify-actions {
    display: flex;
    gap: 0.45rem;
  }

  .archify-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78rem;
    font-weight: 550;
    padding: 0.32rem 0.65rem;
    border-radius: 0.4rem;
    color: var(--sl-color-accent-high, #a4edf0);
    background: color-mix(in srgb, var(--sl-color-accent-low) 55%, transparent);
    border: 1px solid color-mix(in srgb, var(--sl-color-accent) 35%, transparent);
    cursor: pointer;
    text-decoration: none;
    transition: all 0.15s ease-in-out;
    line-height: 1;
  }

  .archify-action-btn:hover {
    background: var(--sl-color-accent);
    color: #041014;
    border-color: var(--sl-color-accent);
    text-decoration: none;
    box-shadow: 0 0 10px rgba(29, 138, 153, 0.4);
  }

  .archify-frame-wrapper {
    position: relative;
    width: 100%;
    min-height: 420px;
    background: #0a1114;
  }

  .archify-iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .archify-embed-footer {
    padding: 0.6rem 1rem;
    background: color-mix(in srgb, var(--sl-color-gray-6, #132025) 75%, transparent);
    border-top: 1px solid color-mix(in srgb, var(--sl-color-accent) 15%, transparent);
  }

  .archify-caption {
    font-size: 0.82rem;
    color: var(--sl-color-gray-2, #a7b6b9);
    margin: 0;
    line-height: 1.4;
  }
</style>
